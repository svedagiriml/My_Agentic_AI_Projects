# ---------- required (all free) ----------
PINECONE_API_KEY=            # https://app.pinecone.io  (Starter plan, free)
GROQ_API_KEY=                # https://console.groq.com (free tier)

# ---------- optional ----------
GOOGLE_API_KEY=              # https://aistudio.google.com (free tier) - used as LLM fallback
LANGFUSE_PUBLIC_KEY=         # https://cloud.langfuse.com (Hobby plan, free) or self-hosted
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PROMPT_CANARY=change-me-to-a-random-string

# ---------- models ----------
LLM_PROVIDER=groq            # groq | gemini | ollama
LLM_FALLBACK_PROVIDER=gemini # groq | gemini | ollama | none
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REWRITE_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---------- vector DB ----------
VECTOR_BACKEND=pinecone      # pinecone | memory
PINECONE_INDEX=bank-loan-support
PINECONE_NAMESPACE=loans
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------- retrieval ----------
DENSE_TOP_K=20
BM25_TOP_K=20
FINAL_TOP_K=5
RRF_K=60

# ---------- resilience / throttling ----------
RETRY_MAX_ATTEMPTS=4
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_TIMEOUT_S=30
LLM_REQUESTS_PER_MINUTE=28
LLM_TOKENS_PER_MINUTE=5500
API_RATE_LIMIT_PER_MINUTE=60

# ---------- cache ----------
CACHE_BACKEND=memory         # memory | redis
REDIS_URL=redis://localhost:6379/0
CACHE_SIMILARITY_THRESHOLD=0.92

# ---------- local service URLs (overridden in docker-compose / Cloud Run) ----------
RETRIEVER_URL=http://localhost:8001
GENERATOR_URL=http://localhost:8002
GUARDRAIL_URL=http://localhost:8003
