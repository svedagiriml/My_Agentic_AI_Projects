# ---------- copy to .env and adjust ----------
ENVIRONMENT=local
LOG_LEVEL=INFO

# LLMs (all free): ollama (local) -> groq (free tier) fallback. Optional: vllm (self-hosted, prefix caching)
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDERS=["groq"]
SUPERVISOR_MODEL=qwen2.5:7b-instruct
SUBAGENT_MODEL=qwen2.5:7b-instruct
JUDGE_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_KEEP_ALIVE=30m
GROQ_API_KEY=
GROQ_SUPERVISOR_MODEL=llama-3.3-70b-versatile
GROQ_SUBAGENT_MODEL=llama-3.1-8b-instant
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Embeddings (free, local). Use "hash" for a zero-dependency demo.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Data stores
REDIS_URL=redis://redis:6379/0
POSTGRES_DSN=postgresql://bank:bank@postgres:5432/bank

# Secrets (>= 32 bytes). In Cloud Run these come from Secret Manager.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
HANDOFF_HMAC_SECRET=dev-only-handoff-secret-change-me-0123456789
DELEGATION_SECRET=dev-only-delegation-secret-change-me-012345678
APPROVAL_SECRET=dev-only-approval-secret-change-me-0123456789ab
SERVICE_AUTH_MODE=local

# HITL thresholds (USD)
HITL_TRANSFER_THRESHOLD=1000
HITL_FUND_SUBSCRIPTION_THRESHOLD=5000
HITL_ATM_LIMIT_THRESHOLD=2000

# Observability (self-hosted Langfuse: docker compose -f docker-compose.observability.yml up)
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
# Shadow prices (USD per 1M tokens) to estimate cost of free models, e.g. GPU amortisation
PRICE_PER_MTOK_INPUT={"default": 0.0, "llama-3.3-70b-versatile": 0.59}
PRICE_PER_MTOK_OUTPUT={"default": 0.0, "llama-3.3-70b-versatile": 0.79}

# Service discovery (docker-compose DNS names; Cloud Run URLs in deploy.sh)
AGENT_URLS={"account":"http://agent-account:8080","payments":"http://agent-payments:8080","cards":"http://agent-cards:8080","fraud":"http://agent-fraud:8080","loans":"http://agent-loans:8080","investments":"http://agent-investments:8080","knowledge":"http://agent-knowledge:8080","compliance":"http://agent-compliance:8080"}
MCP_URLS={"account":"http://mcp-account:8080/mcp/","payments":"http://mcp-payments:8080/mcp/","cards":"http://mcp-cards:8080/mcp/","fraud":"http://mcp-fraud:8080/mcp/","loans":"http://mcp-loans:8080/mcp/","investments":"http://mcp-investments:8080/mcp/","knowledge":"http://mcp-knowledge:8080/mcp/","compliance":"http://mcp-compliance:8080/mcp/"}
EVENT_BUS_BACKEND=redis
