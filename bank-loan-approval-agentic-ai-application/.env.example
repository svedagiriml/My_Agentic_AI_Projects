# ---------- runtime ----------
APP_ENV=local                     # local | test | staging | prod  (prod enforces secure settings)
LOG_LEVEL=INFO
TRANSPORT_MODE=inproc             # inproc (single process) | http (microservices)

# ---------- free LLMs (ordered fallback chain; "rules" = deterministic, no LLM) ----------
LLM_CHAIN=groq,ollama,rules
GROQ_API_KEY=                     # free key: https://console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_SMALL_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=30m             # keep model + KV cache resident
VLLM_BASE_URL=http://localhost:8008/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TEMPERATURE=0
EMBEDDING_BACKEND=hash            # hash | sentence_transformers
EMBEDDING_DIM=384

# ---------- memory ----------
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://loanflow:loanflow@localhost:5432/loanflow
SEMANTIC_CACHE_THRESHOLD=0.92

# ---------- security (generate real secrets; in GCP use Secret Manager) ----------
JWT_SECRET=dev-only-change-me-32-bytes-minimum!!
MESSAGE_HMAC_KEY=dev-hmac-key-change-me
INTERNAL_SERVICE_TOKEN=dev-internal-token
USE_GCP_ID_TOKENS=false
RATE_LIMIT_PER_MINUTE=60

# ---------- resilience ----------
AGENT_TIMEOUT_S=60
TOOL_TIMEOUT_S=15
MAX_RETRIES=3
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_S=30
MAX_CONCURRENT_RUNS=20

# ---------- policy ----------
HITL_AMOUNT_THRESHOLD_INR=5000000
MIN_CREDIT_SCORE=650
MAX_DTI=0.50

# ---------- observability ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
