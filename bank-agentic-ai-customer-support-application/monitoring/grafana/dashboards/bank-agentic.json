{
 "title": "Horizon Agentic Support",
 "uid": "bank-agentic",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Chat p50/p95 latency (s)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(bank_request_latency_seconds_bucket{route=\"/v1/chat\"}[5m])))",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(bank_request_latency_seconds_bucket{route=\"/v1/chat\"}[5m])))",
     "refId": "B"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "LLM latency p95 by model",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, model) (rate(bank_llm_latency_seconds_bucket[5m])))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Tokens / min by service",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (service, direction) (rate(bank_llm_tokens_total[5m])) * 60",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Estimated LLM cost (USD/day)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (model) (increase(bank_llm_cost_usd_total[1d]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Tool calls by outcome",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (tool, outcome) (rate(bank_tool_calls_total[5m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Agent task outcomes",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (agent, status) (rate(bank_agent_tasks_total[5m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Routing cache hit rate",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(bank_routing_cache_total{result=\"hit\"}[15m])) / sum(rate(bank_routing_cache_total{result=~\"hit|miss\"}[15m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "KV prefix reuse rate",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(bank_kv_prefix_total{result=\"hit\"}[15m])) / sum(rate(bank_kv_prefix_total[15m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Guardrail interventions",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (stage, reason) (rate(bank_guardrail_events_total[15m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "HITL events",
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (agent, event) (increase(bank_hitl_events_total[1h]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Circuit breaker state",
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "max by (name) (bank_circuit_state)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Memory ops",
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (store, op, outcome) (rate(bank_memory_ops_total[5m]))",
     "refId": "A"
    }
   ]
  }
 ]
}